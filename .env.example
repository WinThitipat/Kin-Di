# Supabase Public Configuration (Client & Server Safe)
# Do NOT put SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Salted scrypt hash of the 6–12 digit admin PIN. Never store the plaintext PIN.
# Format: scrypt-v1:<64 hex salt>:<128 hex derived key>. Server-only.
ADMIN_DELETE_PIN_HASH=

# Server-only, random 64-character hex secret. Store only its SHA-256 digest
# in private.kindi_server_config. Never prefix this with NEXT_PUBLIC_.
RECIPE_SERVER_SECRET=
